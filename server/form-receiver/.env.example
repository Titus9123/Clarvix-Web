# Copy to /etc/clarvix-form/receiver.env on the VPS, chmod 600, owner root. NEVER commit the real file.
SMTP_HOST=smtp.example.com        # the SMTP server that already handles contact@clarvix.net
SMTP_PORT=587
SMTP_SECURITY=starttls            # starttls | ssl
SMTP_USER=forms@clarvix.net       # a dedicated mailbox/app-password for sending only
SMTP_PASSWORD=change-me
MAIL_FROM=forms@clarvix.net
MAIL_TO=contact@clarvix.net
ALLOWED_ORIGINS=https://web.clarvix.net
BIND=127.0.0.1
PORT=8787
TRUST_PROXY=1
RATE_PER_IP=5
RATE_PER_IP_WINDOW=600
RATE_GLOBAL=60
RATE_GLOBAL_WINDOW=3600
